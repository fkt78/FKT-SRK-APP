{
  "hosting": {
    "site": "shucchou-ryohi-seisan",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      ".git/**",
      "**/.git/**",
      "**/*.md",
      "**/*.sh",
      "omake-app-redirect/**"
    ],
    "redirects": [
      {
        "source": "/出張手当管理アプリ.html",
        "destination": "/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(html|js|json)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.@(svg|png|ico)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=86400" }]
      }
    ]
  }
}
